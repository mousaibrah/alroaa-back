DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DB_NAME
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:5173
# Payments (mock gateway by default). Required in production.
PAYMENT_WEBHOOK_SECRET=change-me
PAYMENT_CHECKOUT_URL=http://localhost:5173/checkout
# Video playback: private video URLs are signed with this secret and expire after
# PLAYBACK_URL_TTL_SEC seconds (default 900). Required in production.
PLAYBACK_SIGNING_SECRET=change-me
PLAYBACK_URL_TTL_SEC=900

# Media uploads: S3-compatible storage (RustFS locally). Needs ffmpeg/ffprobe on the PATH.
# S3_ENDPOINT = how the API reaches the storage; S3_PUBLIC_ENDPOINT = the host the browser
# uses in presigned URLs (the same in dev). Keep RustFS bound to localhost.
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=alroaa
S3_ACCESS_KEY=Admin
S3_SECRET_KEY="Pass1234@"

# Base of public (non-private) file URLs; defaults to S3_PUBLIC_ENDPOINT/S3_BUCKET
S3_PUBLIC_BASE_URL=http://127.0.0.1:9000/alroaa
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=1024
# Origins allowed to PUT/GET files in the bucket (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# scripts/dev-rustfs.sh (local only)
RUSTFS_BIN=~/rustfs/bin/rustfs
RUSTFS_DATA_DIR=~/rustfs/data
# RUSTFS_PORT=9000
# RUSTFS_CONSOLE_PORT=9001
# Media processing jobs run at once (1 or 2)
# MEDIA_WORKER_CONCURRENCY=1

# Contact us form: SMTP account that sends the emails (port 465 = SSL/TLS).
# CONTACT_TO_EMAIL is the inbox that receives them (defaults to SMTP_USER).
SMTP_HOST=mail.rnec.sa
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
CONTACT_TO_EMAIL=




