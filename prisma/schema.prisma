// Mirrors database/schema.sql. The SQL file stays the source of truth for the
// database (CHECK constraints and updated_at triggers live only there).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CourseStatus {
  draft
  published
  archived

  @@map("course_status")
}

enum LessonType {
  video
  text

  @@map("lesson_type")
}

enum QuestionType {
  single_choice
  multiple_choice
  true_false

  @@map("question_type")
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded

  @@map("payment_status")
}

enum TransactionType {
  charge
  refund
  void

  @@map("transaction_type")
}

enum TransactionStatus {
  pending
  success
  failed

  @@map("transaction_status")
}

enum AttemptStatus {
  in_progress
  submitted
  expired

  @@map("attempt_status")
}

enum EnrollmentStatus {
  active
  completed
  cancelled
  expired

  @@map("enrollment_status")
}

// ---------------------------------------------------------------
// Roles & permissions
// ---------------------------------------------------------------
model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String?
  isDeleted   Boolean  @default(false) @map("is_deleted")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String?
  isDeleted   Boolean  @default(false) @map("is_deleted")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  isDeleted    Boolean    @default(false) @map("is_deleted")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@index([permissionId], map: "idx_role_permissions_permission_id")
  @@map("role_permissions")
}

// ---------------------------------------------------------------
// Users
// ---------------------------------------------------------------
model User {
  id          Int       @id @default(autoincrement())
  firstName   String    @map("first_name") @db.VarChar(100)
  lastName    String    @map("last_name") @db.VarChar(100)
  firstNameAr String?   @map("first_name_ar") @db.VarChar(100)
  lastNameAr  String?   @map("last_name_ar") @db.VarChar(100)
  email       String    @unique @db.VarChar(255)
  password    String    @db.VarChar(255) // bcrypt hash
  image       String?
  gender      BigInt? // 0 = male, 1 = female
  dob         DateTime? @db.Date
  roleId      Int       @map("role_id")
  isDeleted   Boolean   @default(false) @map("is_deleted")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  courses        Course[]
  payments       Payment[]
  enrollments    Enrollment[]
  lessonProgress LessonProgress[]
  examAttempts   ExamAttempt[]
  certificates   Certificate[]
  media          Media[]

  @@index([roleId], map: "idx_users_role_id")
  @@map("users")
}

// ---------------------------------------------------------------
// Courses
// ---------------------------------------------------------------
model Course {
  id               Int          @id @default(autoincrement())
  titleEn          String       @map("title_en") @db.VarChar(255)
  titleAr          String       @map("title_ar") @db.VarChar(255)
  slug             String       @unique @db.VarChar(255)
  descriptionEn    String?      @map("description_en")
  descriptionAr    String?      @map("description_ar")
  price            Decimal      @default(0) @db.Decimal(10, 2)
  currency         String       @default("USD") @db.Char(3)
  status           CourseStatus @default(draft)
  authorId         Int          @map("author_id")
  thumbnailUrl     String?      @map("thumbnail_url")
  thumbnailMediaId String?      @map("thumbnail_media_id") @db.Uuid
  isDeleted        Boolean      @default(false) @map("is_deleted")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  author           User         @relation(fields: [authorId], references: [id], onDelete: Restrict)
  thumbnailMedia   Media?       @relation("CourseThumbnail", fields: [thumbnailMediaId], references: [id], onDelete: SetNull)

  sections     CourseSection[]
  exams        Exam[]
  payments     Payment[]
  enrollments  Enrollment[]
  certificates Certificate[]

  @@index([authorId], map: "idx_courses_author_id")
  @@index([thumbnailMediaId], map: "idx_courses_thumbnail_media_id")
  @@map("courses")
}

model CourseSection {
  id            Int      @id @default(autoincrement())
  courseId      Int      @map("course_id")
  titleEn       String   @map("title_en") @db.VarChar(255)
  titleAr       String   @map("title_ar") @db.VarChar(255)
  descriptionEn String?  @map("description_en")
  descriptionAr String?  @map("description_ar")
  sortOrder     Int      @default(0) @map("sort_order")
  isDeleted     Boolean  @default(false) @map("is_deleted")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessons Lesson[]

  @@index([courseId], map: "idx_course_sections_course_id")
  @@map("course_sections")
}

model Lesson {
  id             Int           @id @default(autoincrement())
  sectionId      Int           @map("section_id")
  titleEn        String        @map("title_en") @db.VarChar(255)
  titleAr        String        @map("title_ar") @db.VarChar(255)
  descriptionEn  String?       @map("description_en")
  descriptionAr  String?       @map("description_ar")
  lessonType     LessonType    @map("lesson_type")
  contentUrl     String?       @map("content_url")
  contentMediaId String?       @map("content_media_id") @db.Uuid
  durationSec    Int?          @map("duration_sec")
  sortOrder      Int           @default(0) @map("sort_order")
  isPreview      Boolean       @default(false) @map("is_preview")
  isDeleted      Boolean       @default(false) @map("is_deleted")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  section        CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  contentMedia   Media?        @relation("LessonMedia", fields: [contentMediaId], references: [id], onDelete: SetNull)

  progress LessonProgress[]

  @@index([sectionId], map: "idx_lessons_section_id")
  @@index([contentMediaId], map: "idx_lessons_content_media_id")
  @@map("lessons")
}

// ---------------------------------------------------------------
// Exams
// ---------------------------------------------------------------
model Exam {
  id            Int      @id @default(autoincrement())
  courseId      Int      @map("course_id")
  titleEn       String   @map("title_en") @db.VarChar(255)
  titleAr       String   @map("title_ar") @db.VarChar(255)
  descriptionEn String?  @map("description_en")
  descriptionAr String?  @map("description_ar")
  passingScore  Decimal  @default(0) @map("passing_score") @db.Decimal(5, 2)
  durationSec   Int?     @map("duration_sec")
  isDeleted     Boolean  @default(false) @map("is_deleted")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  questions Question[]
  attempts  ExamAttempt[]

  @@index([courseId], map: "idx_exams_course_id")
  @@map("exams")
}

model Question {
  id           Int          @id @default(autoincrement())
  examId       Int          @map("exam_id")
  textEn       String       @map("text_en")
  textAr       String       @map("text_ar")
  questionType QuestionType @map("question_type")
  points       Decimal      @default(1) @db.Decimal(5, 2)
  sortOrder    Int          @default(0) @map("sort_order")
  isDeleted    Boolean      @default(false) @map("is_deleted")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  exam         Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)

  options QuestionOption[]

  @@index([examId], map: "idx_questions_exam_id")
  @@map("questions")
}

model QuestionOption {
  id           Int      @id @default(autoincrement())
  questionId   Int      @map("question_id")
  optionTextEn String   @map("option_text_en")
  optionTextAr String   @map("option_text_ar")
  isCorrect    Boolean  @default(false) @map("is_correct")
  sortOrder    Int      @default(0) @map("sort_order")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId], map: "idx_question_options_question_id")
  @@map("question_options")
}

// ---------------------------------------------------------------
// Payments, enrollments & progress
// ---------------------------------------------------------------
model Payment {
  id                Int           @id @default(autoincrement())
  userId            Int           @map("user_id")
  courseId          Int           @map("course_id")
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("USD") @db.Char(3)
  status            PaymentStatus @default(pending)
  provider          String        @db.VarChar(50)
  providerPaymentId String        @map("provider_payment_id") @db.VarChar(255)
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz(6)
  isDeleted         Boolean       @default(false) @map("is_deleted")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  user              User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  course            Course        @relation(fields: [courseId], references: [id], onDelete: Restrict)

  transactions PaymentTransaction[]
  enrollments  Enrollment[]

  @@unique([provider, providerPaymentId])
  @@index([userId], map: "idx_payments_user_id")
  @@index([courseId], map: "idx_payments_course_id")
  @@map("payments")
}

model PaymentTransaction {
  id                      Int               @id @default(autoincrement())
  paymentId               Int               @map("payment_id")
  provider                String            @db.VarChar(50)
  providerTransactionId   String            @map("provider_transaction_id") @db.VarChar(255)
  transactionType         TransactionType   @map("transaction_type")
  amount                  Decimal           @db.Decimal(10, 2)
  currency                String            @default("USD") @db.Char(3)
  status                  TransactionStatus @default(pending)
  responseCodeProvider    String?           @map("response_code_provider") @db.VarChar(100)
  responseMessageProvider String?           @map("response_message_provider")
  isDeleted               Boolean           @default(false) @map("is_deleted")
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  payment                 Payment           @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, providerTransactionId])
  @@index([paymentId], map: "idx_payment_transactions_payment_id")
  @@map("payment_transactions")
}

model Enrollment {
  id          Int              @id @default(autoincrement())
  userId      Int              @map("user_id")
  courseId    Int              @map("course_id")
  paymentId   Int?             @map("payment_id") // null for free courses
  status      EnrollmentStatus @default(active)
  enrolledAt  DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  completedAt DateTime?        @map("completed_at") @db.Timestamptz(6)
  isDeleted   Boolean          @default(false) @map("is_deleted")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  user        User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  payment     Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
  @@index([courseId], map: "idx_enrollments_course_id")
  @@index([paymentId], map: "idx_enrollments_payment_id")
  @@map("enrollments")
}

model LessonProgress {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  lessonId    Int       @map("lesson_id")
  progressSec Int       @default(0) @map("progress_sec")
  completed   Boolean   @default(false)
  lastAccess  DateTime? @map("last_access") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  isDeleted   Boolean   @default(false) @map("is_deleted")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId], map: "idx_lesson_progress_lesson_id")
  @@map("lesson_progress")
}

// ---------------------------------------------------------------
// Exam attempts (the partial unique index for one active attempt per learner
// and exam lives only in the SQL)
// ---------------------------------------------------------------
model ExamAttempt {
  id          Int           @id @default(autoincrement())
  examId      Int           @map("exam_id")
  userId      Int           @map("user_id")
  status      AttemptStatus @default(in_progress)
  startedAt   DateTime      @default(now()) @map("started_at") @db.Timestamptz(6)
  expiresAt   DateTime?     @map("expires_at") @db.Timestamptz(6)
  submittedAt DateTime?     @map("submitted_at") @db.Timestamptz(6)
  score       Decimal?      @db.Decimal(7, 2)
  maxScore    Decimal?      @map("max_score") @db.Decimal(7, 2)
  passed      Boolean?
  answers     Json?
  result      Json?
  isDeleted   Boolean       @default(false) @map("is_deleted")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  exam        Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  certificates Certificate[]

  @@index([examId, userId], map: "idx_exam_attempts_exam_user")
  @@map("exam_attempts")
}

// Issued once a learner has passed every exam of a course. The name and title
// are snapshots. One per learner and course (a partial unique index in SQL).
model Certificate {
  id              Int          @id @default(autoincrement())
  code            String       @unique @db.VarChar(32)
  userId          Int          @map("user_id")
  courseId        Int          @map("course_id")
  attemptId       Int?         @map("attempt_id")
  holderName      String       @map("holder_name") @db.VarChar(255)
  holderNameAr    String?      @map("holder_name_ar") @db.VarChar(255)
  courseTitleEn   String       @map("course_title_en") @db.VarChar(255)
  courseTitleAr   String       @map("course_title_ar") @db.VarChar(255)
  learningSeconds Int          @default(0) @map("learning_seconds")
  issuedAt        DateTime     @default(now()) @map("issued_at") @db.Timestamptz(6)
  isDeleted       Boolean      @default(false) @map("is_deleted")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attempt         ExamAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@index([userId], map: "idx_certificates_user_id")
  @@map("certificates")
}

// ---------------------------------------------------------------
// Media uploads (files live in S3-compatible storage; pg-boss keeps its own
// `pgboss` schema which is deliberately not modelled here)
// ---------------------------------------------------------------
enum MediaType {
  image
  video

  @@map("media_type")
}

enum MediaStatus {
  pending
  uploaded
  processing
  ready
  failed

  @@map("media_status")
}

model Media {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId       Int?        @map("owner_id")
  key           String      @unique
  type          MediaType
  mimeType      String      @map("mime_type") @db.VarChar(100)
  size          BigInt
  originalName  String      @map("original_name") @db.VarChar(255)
  status        MediaStatus @default(pending)
  width         Int?
  height        Int?
  durationSec   Int?        @map("duration_sec")
  thumbnailKey  String?     @map("thumbnail_key")
  variants      Json?
  isPrivate     Boolean     @default(false) @map("is_private")
  failureReason String?     @map("failure_reason")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  owner         User?       @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  lessons Lesson[] @relation("LessonMedia")
  courses Course[] @relation("CourseThumbnail")

  @@index([ownerId], map: "idx_media_owner_id")
  @@index([status], map: "idx_media_status")
  @@map("media")
}
